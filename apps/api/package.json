{
  "name": "@togato/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/db/migrate.js && node dist/index.js",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed.ts",
    "test": "vitest run",
    "test:int": "vitest run --config vitest.int.config.ts",
    "start:dev": "tsx src/index.ts",
    "worker": "node dist/worker.js",
    "worker:dev": "tsx watch src/worker.ts",
    "reencrypt": "node dist/scripts/reencrypt.js",
    "reencrypt:dev": "tsx src/scripts/reencrypt.ts",
    "docs:routes": "tsx src/scripts/routesDoc.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@aws-sdk/client-s3": "^3.1161.0",
    "@hono/node-server": "^2.1.6",
    "@togato/shared": "*",
    "bcryptjs": "^2.4.3",
    "docx": "^9.15.1",
    "dotenv": "^16.4.0",
    "drizzle-orm": "^0.45.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.0",
    "pdfkit": "^0.17.2",
    "postgres": "^3.4.0",
    "qrcode": "^1.5.4",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/pdfkit": "^0.17.7",
    "@types/qrcode": "^1.5.6",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.7"
  }
}
