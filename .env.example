# API
DATABASE_URL=postgres://togato:togato@localhost:5432/togato
JWT_SECRET=schimba-acest-secret-lung-si-aleator
# Cheie pentru criptarea secretelor 2FA (64 caractere hex): openssl rand -hex 32
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
PORT=8080
# Câte proxy-uri de încredere sunt în fața API-ului (producție: 2 = marginea platformei + Next.js)
TRUST_PROXY_HOPS=0
# Opțional: memoriul juridic generat cu AI
ANTHROPIC_API_KEY=
# Opțional: date extinse despre firme (angajați, cifră de afaceri)
LISTAFIRME_API_KEY=
# Emailuri: log (scrie în jurnal) | resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Togato <noreply@togato.ro>
# Joburile rulează și în API; puneți off dacă rulați workerul separat (npm run worker -w @togato/api)
RUN_WORKER_IN_API=on
# Jurnal JSON pe stdout: debug | info | warn | error
LOG_LEVEL=info
# Opțional: raportarea erorilor neprevăzute (Sentry, fără SDK)
SENTRY_DSN=

# Web
API_INTERNAL_URL=http://localhost:8080
