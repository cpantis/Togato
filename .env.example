# API
DATABASE_URL=postgres://togato:togato@localhost:5432/togato
JWT_SECRET=schimba-acest-secret-lung-si-aleator
# Cheie pentru criptarea secretelor 2FA (64 caractere hex): openssl rand -hex 32
ENCRYPTION_KEY=
FRONTEND_URL=http://localhost:3000
PORT=8080
# Câte proxy-uri de încredere sunt în fața API-ului (producție: 2 = marginea platformei + Next.js)
TRUST_PROXY_HOPS=0
# Opțional: memoriul juridic generat cu AI
ANTHROPIC_API_KEY=
# Opțional: date extinse despre firme (angajați, cifră de afaceri)
LISTAFIRME_API_KEY=
# Emailuri: log (scrie în jurnal) | resend
EMAIL_PROVIDER=log
RESEND_API_KEY=
EMAIL_FROM=Togato <noreply@togato.ro>
# Joburile rulează și în API; puneți off dacă rulați workerul separat (npm run worker -w @togato/api)
RUN_WORKER_IN_API=on
# Fișiere: local (STORAGE_LOCAL_DIR) | s3 (S3 sau Cloudflare R2)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
S3_BUCKET=
S3_REGION=auto
# R2: https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Opțional: plata online a abonamentelor (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_CABINET=
# Echipa Togato (consola /platform), separate prin virgulă; necesită 2FA
PLATFORM_ADMIN_EMAILS=
# Confirmarea emailului la înregistrare și 2FA pentru administratori (implicit: active doar în producție)
# REQUIRE_EMAIL_VERIFICATION=on
# REQUIRE_ADMIN_2FA=on
# Antivirus pentru fișierele încărcate (clamd); fără CLAMAV_HOST nu se scanează
# CLAMAV_HOST=clamav.railway.internal
# CLAMAV_PORT=3310
# CLAMAV_FAIL_OPEN=off
# Captcha Cloudflare Turnstile (înregistrare, autoevaluare, recuperare) — cheia secretă la API, cea publică la web
# TURNSTILE_SECRET_KEY=
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# Webhook Resend (email.bounced, email.complained) → https://<domeniul web>/api/email/webhook
# RESEND_WEBHOOK_SECRET=whsec_...
# Jurnal JSON pe stdout: debug | info | warn | error
LOG_LEVEL=info
# Opțional: raportarea erorilor neprevăzute (Sentry, fără SDK)
SENTRY_DSN=

# Web
API_INTERNAL_URL=http://localhost:8080
NEXT_PUBLIC_CONTACT_EMAIL=contact@togato.ro
# adresa publică a site-ului (sitemap, robots)
# NEXT_PUBLIC_SITE_URL=https://togato.ro
# analitică fără cookie-uri (Plausible), doar pe paginile de prezentare; fără ea, nimic nu se încarcă
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=togato.ro
# NEXT_PUBLIC_PLAUSIBLE_SRC=https://plausible.io/js/script.js
